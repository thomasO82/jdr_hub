POSTGRES_DB=jdr_hub_dev
POSTGRES_USER=jdr_hub_app
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://jdr_hub_app:local-development-only@postgres:5432/jdr_hub_dev
APP_ORIGIN=http://localhost:18080
API_INTERNAL_URL=http://api-hono:8787
DISCORD_CLIENT_ID=replace-with-public-client-id
