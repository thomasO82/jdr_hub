DISCORD_REDIRECT_URI=http://localhost:18080/api/auth/discord/callback
DISCORD_GUILD_ID=replace-with-dedicated-discord-server-id
DISCORD_BOT_TOKEN=
DISCORD_NOTIFICATION_INTERVAL_MS=30000
DISCORD_NOTIFICATION_BATCH_LIMIT=10
JWT_SIGNING_SECRET=replace-with-base64url-encoded-32-byte-secret
